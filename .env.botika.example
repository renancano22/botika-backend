# Copy these lines into botika-backend/.env (replace the DB_ lines there)

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=botika
DB_USERNAME=root
DB_PASSWORD=

# Semaphore SMS (https://semaphore.co). Leave the key empty to only log SMS messages.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

BOTIKA_EXPIRY_WARNING_DAYS=30
BOTIKA_FORECAST_HISTORY_MONTHS=12
